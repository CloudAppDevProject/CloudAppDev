# Microservices Configuration

# Service URLs (for backend-to-backend communication in Docker)
ITINERARY_SERVICE_URL=http://itinerary-service:8081/api/v1
USER_SERVICE_URL=http://user-service:8080/api/v1
SOCIAL_SERVICE_URL=http://social-service:8082/api/v1

# Frontend will use these (public - localhost for browser access)
NEXT_PUBLIC_ITINERARY_SERVICE_URL=http://localhost:8081/api/v1
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SOCIAL_SERVICE_URL=http://localhost:8082/api/v1

# Database URLs (for seeding from host machine)
USER_DATABASE_URL=postgresql://appuser:devpass123@localhost:5433/users_db?schema=public
ITINERARY_DATABASE_URL=postgresql://appuser:devpass123@localhost:5434/itineraries_db?schema=public
SOCIAL_MONGODB_URI=mongodb://localhost:27017/social_db

# Firebase Configuration (required)
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=your_base64_encoded_service_account_here
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Google Cloud Storage (optional)
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name
GOOGLE_CLOUD_CREDENTIALS_BASE64=your_base64_encoded_credentials_here
