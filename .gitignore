# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# package manager
# package-lock.json  # Commented out - lock files should be committed for reproducible builds

# vscode
.vscode/settings.json

# database
data/itineraries.db

# MongoDB
mongo-backups/
*.bson
*.metadata.json

# Docker volumes (if using local bind mounts)
mongo_data/
mongo_config/
/generated/prisma
/certbot/conf/
/certbot/www/
/certbot/cloudflare.ini
letsencrypt/
**/fullchain.pem
**/privkey.pem
.seed-cache/

# Locust
**/locust/__pycache__
.venv/
locust/reports/*
.opencode
.claude
CloudAppDev/*

# terraform
**/.terraform/
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.backup
**/tfplan
**/*.tfvars
!**/*.tfvars.example
**/crash.log
**/crash.*.log
**/.terraformrc
/scripts/node_modules
terraform/backup-state.json

# services
/services/**/node_modules
/services/**/dist
/services/**/build
/services/**/.env
/services/**/coverage
settings.local.json

# Kubernetes
k8s/**/*secrets*
k8s/**/*secrets*/