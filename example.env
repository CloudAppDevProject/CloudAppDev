# POSTGRESQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# MONGODB
MONGO_INITDB_DATABASE=clouddev

# Optional: Override host/port for local development
# MONGO_HOST=localhost
# MONGO_PORT=27017

# MongoDB URI - Use this for Firestore connection or override with custom URI
# For Firestore: mongodb://clouddev-user:PASSWORD@FIRESTORE_HOST:443/clouddev?loadBalanced=true&tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false
MONGODB_URI=mongodb://clouddev-user:0jNKfx52ZTi86StfWx3jaQna7fnqEvUEtS3tuRlG_BGLTvaC@ee1ba746-53d7-42a2-aa9e-8d231ae4c4f4.eur3.firestore.goog:443/clouddev?loadBalanced=true&tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false

# This was inserted by `prisma init`:
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Local development (with connection pooling)
# connection_limit=10: Max 10 connections per application instance
# pool_timeout=60: 60 seconds timeout for getting a connection from pool
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public&connection_limit=10&pool_timeout=60"

# For Cloud Run (set automatically by deploy.ps1):
# DATABASE_URL="postgresql://USER:PASS@localhost/DB?host=/cloudsql/CONNECTION&pgbouncer=true&connection_limit=10&pool_timeout=60&connect_timeout=30"

# TLS / Certbot
DOMAIN=
# Your email to receive important certbot email log files (can be replaced with "c")
CLOUDFLARE_API_TOKEN=
CERTBOT_EMAIL=
CERTBOT_DOMAINS=


# Google Cloud Storage Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name
GOOGLE_CLOUD_CREDENTIALS_BASE64=your-base64-encoded-json-key

# Firebase Configuration
NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_ID=your-project-id
NEXT_PUBLIC_GOOGLE_CLOUD_AUTH_KEY=your-firebase-api-key
NEXT_PUBLIC_GOOGLE_CLOUD_AUTH_DOMAIN=your-firebase-auth-domain

# FIREBASE ADMIN
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=your-base64-encoded-firebase-admin-sdk-json-key

# WEATHER API
WEATHER_API_KEY=your_weather_api_key_here