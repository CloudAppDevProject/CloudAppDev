# ==================== REQUIRED CONFIGURATION ====================

# API Gateway - Backend (server-side) proxy routes need this to reach the gateway
# LOCAL DEV: Use localhost:8000 (from host machine perspective)
# KUBERNETES: Use http://api-gateway:80 (from within cluster)
API_GATEWAY_URL=http://localhost:8000

# JWT Secret - Used for verifying JWTs in server-side API routes
# IMPORTANT: Change this in production to a secure random string
JWT_SECRET=dev-jwt-secret-change-in-production

# ==================== TENANT CONFIGURATION ====================

# Default Free Tenant Name - Name for the default free tier tenant (ID: 1)
# This tenant is automatically created during deployment
# Change this to customize your free tier branding
FREE_TENANT_NAME=Free Community

# ==================== MONITORING CONFIGURATION ====================

# GCP Project ID - Used for Cloud Monitoring API queries
# Get this from: gcloud config get-value project
GCP_PROJECT_ID=your-gcp-project-id

# GCP Service Account Credentials (Base64 encoded JSON)
# For local dev: Use service account with roles/monitoring.viewer
# For production: Use Workload Identity
GCP_MONITORING_CREDENTIALS_BASE64=




