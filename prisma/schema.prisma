generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int         @id @default(autoincrement())
  name       String
  email      String      @unique
  password   String
  itineraries Itinerary[]
  comments    Comment[]
}

model Itinerary {
  id          Int      @id @default(autoincrement())
  user_id     Int
  title       String
  destination String
  start_date  String
  short_desc  String?
  detail_desc String?
  created_at  DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [id])
  comments    Comment[]
}

model Comment {
  id           Int       @id @default(autoincrement())
  user_id      Int
  itinerary_id Int
  content      String
  created_at   DateTime  @default(now())
  user         User      @relation(fields: [user_id], references: [id])
  itinerary    Itinerary @relation(fields: [itinerary_id], references: [id], onDelete: Cascade)
}