FROM nginx:alpine

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Install gettext for envsubst
RUN apk add --no-cache gettext

# Copy gateway config (will be processed at runtime)
COPY gateway.conf /etc/nginx/templates/gateway.conf.template

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

# Nginx image with templates support auto-substitutes environment variables
# Files in /etc/nginx/templates/*.template are processed by envsubst before nginx starts
