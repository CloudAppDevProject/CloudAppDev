generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String?
  googleUid  String?  @unique
  avatarUrl  String?  @db.VarChar(500)
  tenantId   Int?     // Reference to Tenant in Tenant Service (nullable for migration)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
  @@index([googleUid])
  @@index([tenantId])
}
