# Server Configuration
NODE_ENV=development
PORT=8080

# Database
DATABASE_URL=postgresql://appuser:devpass123@localhost:5433/users_db?schema=public

# JWT Secret
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRATION=7d

# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=your-base64-encoded-service-account

# Google Cloud Storage
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name
GOOGLE_CLOUD_CREDENTIALS_BASE64=your-base64-encoded-credentials
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Frontend
FRONTEND_URL=http://localhost:3000
