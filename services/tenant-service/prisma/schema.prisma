generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  uuid                  String   @id @default(uuid()) @db.Uuid
  name                  String   @db.VarChar(255)                  // Organization name
  email                 String   @unique @db.VarChar(255)          // Admin email for login
  password              String   @db.VarChar(255)                  // Hashed password (bcrypt)
  namespace             String   @unique @db.VarChar(63)           // Unique slug -> K8s namespace
  tier                  String   @default("free")                  // free, standard, enterprise
  domain                String?  @db.VarChar(255)                  // Provisioned domain URL
  provisioningStatus    String   @default("pending") @map("provisioning_status") // pending, provisioning, provisioned, failed
  provisioningError     String?  @map("provisioning_error")        // Error message if provisioning failed
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([namespace])
  @@index([tier])
  @@index([provisioningStatus])
  @@map("tenants")
}
